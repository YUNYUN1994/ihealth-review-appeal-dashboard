NODE_ENV=production
TZ=Asia/Shanghai
APP_SLUG=review-appeals
APP_BASE_PATH=/apps/review-appeals/
HOST=127.0.0.1
PORT=8771
FEISHU_APP_ID=replace_with_shared_feishu_app_id
FEISHU_APP_SECRET=replace_with_shared_feishu_app_secret
FEISHU_SOURCES_FILE=/etc/ihealth-apps/review-appeals.feishu.json
APP_DATA_DIR=/var/lib/ihealth-apps/review-appeals
FEISHU_TIMEOUT_MS=30000
